<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.starshop.mapper.ProductCommentMapper">

    <update id="updateProductCommentLikeCount">
        UPDATE product_comment
        SET like_count = CASE id
        <foreach collection="map" item="val" index="key">
            WHEN #{key} THEN like_count + #{val}
        </foreach>
        END
        WHERE id IN
        <foreach collection="map" index="key" open="(" separator="," close=")">
            #{key}
        </foreach>
    </update>
</mapper>